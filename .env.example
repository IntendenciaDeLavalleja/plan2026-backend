FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

SECRET_KEY=generate-a-random-secret

DATABASE_URI=mariadb+mariadbconnector://root:YOUR_PASSWORD@127.0.0.1:3306/amnistia_db

REDIS_URL=redis://127.0.0.1:6379/0
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0

FRONTEND_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@localhost.test
MAIL_SUPPRESS_SEND=true

RESERVATION_CODE_PREFIX=IDL-AF

WTF_CSRF_SECRET_KEY=generate-another-random-secret

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@localhost.test
BOOTSTRAP_ADMIN_PASSWORD=set-a-secure-local-password
