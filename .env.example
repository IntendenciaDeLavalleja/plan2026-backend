FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

SECRET_KEY=generate-a-random-secret
JWT_SECRET_KEY=generate-a-random-jwt-secret

DATABASE_URI=mariadb+mariadbconnector://root:YOUR_PASSWORD@127.0.0.1:3306/amnistia_db

REDIS_URL=redis://127.0.0.1:6379/0
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0

FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Origin of the separate dashboard SPA (JWT bearer, cross-origin, no cookies).
DASHBOARD_ALLOWED_ORIGIN=http://localhost:5174

MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@localhost.test
# When true, Flask-Mail discards outgoing mail instead of connecting to MAIL_SERVER.
# Only for local/dev environments without a real mailbox.
MAIL_SUPPRESS_SEND=false
# Fixed 2FA code for local/dev testing without a real mailbox. NEVER set in production.
DEV_TWO_FACTOR_CODE=

RESERVATION_CODE_PREFIX=IDL-AF

WTF_CSRF_SECRET_KEY=generate-another-random-secret

